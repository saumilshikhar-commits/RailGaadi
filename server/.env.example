# Server
PORT=3001
NODE_ENV=development

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# Redis (optional for local dev — in-memory cache used as fallback)
REDIS_URL=redis://localhost:6379

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/railgaadi

# Provider: Railradar
RAILRADAR_BASE_URL=https://railradar.trainfo.in
RAILRADAR_API_KEY=

# Provider: OpenWeather
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# Provider: OpenTopography
OPENTOPOGRAPHY_API_KEY=
OPENTOPOGRAPHY_BASE_URL=https://portal.opentopography.org/API

# Provider: Overpass / OSM
OVERPASS_BASE_URL=https://overpass-api.de/api

# MapTiler (for frontend — keep restricted to allowed origins)
MAPTILER_API_KEY=

# Caching TTLs (seconds)
CACHE_TTL_SEARCH=600
CACHE_TTL_JOURNEY=43200
CACHE_TTL_LIVE=20
CACHE_TTL_WEATHER=600
CACHE_TTL_ELEVATION=604800
CACHE_TTL_CONTEXT=86400

# Live refresh
LIVE_REFRESH_INTERVAL_MS=30000
LIVE_REFRESH_JITTER_MS=5000

# Rate limiting (requests per minute)
RATE_LIMIT_SEARCH=60
RATE_LIMIT_LIVE=120
RATE_LIMIT_WEATHER=30
RATE_LIMIT_CONTEXT=20
